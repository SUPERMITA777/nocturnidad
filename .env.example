# Variables de Entorno - Nocturnidad Segura FV
# Copiar este archivo como .env.local y completar con valores reales

# ========================
# FIREBASE ADMIN SDK
# ========================
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
# La clave privada debe estar en una línea con \n escapados
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_AQUI\n-----END PRIVATE KEY-----\n"

# ========================
# CLOUDFLARE TURNSTILE (Anti-Bot)
# ========================
# Clave pública para el widget del cliente
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAAAAxxxxxxxxxxxxxxx
# Clave secreta para verificación en el servidor
TURNSTILE_SECRET_KEY=0x4AAAAAAAAAAxxxxxxxxxxxxxxx

# ========================
# ADMINISTRACIÓN
# ========================
# Clave secreta para el endpoint de exportación CSV
ADMIN_SECRET_KEY=cambia_esta_clave_por_una_segura_y_larga
